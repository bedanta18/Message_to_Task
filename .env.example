# ─── Google OAuth (Gmail read-only) ────────────────────────────────────────────
# Create an OAuth 2.0 "Web application" client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
# Local:      http://localhost:3000/tools/agency-action-hub/api/auth/google/callback
# Production: https://www.aipmbedanta.com/tools/agency-action-hub/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ─── AI (any OpenAI-compatible Chat Completions API) ──────────────────────────
OPENAI_API_KEY=
# Optional. Defaults to https://api.openai.com/v1
AI_BASE_URL=
# Optional. Default model (can also be changed in Settings).
AI_MODEL=gpt-4.1-mini
# Optional. "json_schema" (strict structured output, default) or "json_object"
# for providers that do not support JSON Schema response formats.
AI_RESPONSE_FORMAT=json_schema
# Optional. Emails analysed in parallel (1-5, default 3). Use 1 on free tiers.
AI_CONCURRENCY=
# Optional. low | medium | high — only for reasoning models (e.g. openai/gpt-oss-*).
AI_REASONING_EFFORT=
#
# Example — Groq (free tier, OpenAI-compatible):
#   OPENAI_API_KEY=gsk_...
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b      # supports strict json_schema
#   AI_RESPONSE_FORMAT=json_schema
#   AI_REASONING_EFFORT=low
#   AI_CONCURRENCY=1
# Llama on Groq (e.g. llama-3.3-70b-versatile) has no strict schemas: use AI_RESPONSE_FORMAT=json_object

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase/Postgres connection string (use the pooled connection on Vercel).
# For zero-setup local dev you can use embedded Postgres: pglite://./.data/pglite
DATABASE_URL=

# ─── App ──────────────────────────────────────────────────────────────────────
# Public URL of the tool INCLUDING the base path, no trailing slash.
# Local:      http://localhost:3000/tools/agency-action-hub
# Production: https://www.aipmbedanta.com/tools/agency-action-hub
NEXT_PUBLIC_APP_URL=

# ─── Security ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with: npm run gen:key
# Encrypts Gmail OAuth tokens at rest (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=
# 32+ random characters. Signs session + OAuth state cookies.
SESSION_SECRET=
# Comma-separated Gmail accounts allowed to connect (everyone else gets the demo).
ALLOWED_EMAILS=bedanta.product@gmail.com
# Protects the scheduled sync endpoint (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Optional. Used for "due today" / "overdue". Defaults to Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata
